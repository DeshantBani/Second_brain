# --- Gemini (the one paid/hosted dependency in this stack) ---
# Get a key at https://aistudio.google.com/apikey. NOTE (verified live during build):
# a free-tier key has very little usable quota - Pro-tier models 429 immediately, and
# the full "flash" model is capped around ~20 requests/day, nowhere near enough for a
# demo. "flash-lite" variants carry meaningfully more free daily quota, hence the
# defaults below. Also note free-tier content is used by Google to improve their
# products - fine for this demo's synthetic fixtures, switch to a paid-tier key (or
# back to OpenAI, see README) before ever pointing this at real client data.
GEMINI_API_KEY=
MODEL_FAST=gemini-flash-lite-latest
MODEL_STRONG=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# --- Case law reliability provider ---
CASE_LAW_PROVIDER=mock
INDIANKANOON_API_TOKEN=

# --- Postgres (self-hosted via docker-compose) ---
POSTGRES_DB=second_brain
POSTGRES_USER=sb_owner
POSTGRES_PASSWORD=sb_owner_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Runtime app role, subject to Row-Level Security (created by db_bootstrap)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_dev_password

# Owner connection (bypasses RLS) - used by migrations/seed
DATABASE_URL_OWNER=postgresql+psycopg://sb_owner:sb_owner_dev_password@postgres:5432/second_brain
# Runtime connection (RLS-enforced) - used by the API at request time
DATABASE_URL=postgresql+psycopg://app_user:app_user_dev_password@postgres:5432/second_brain

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (self-hosted, S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sb_minio_admin
MINIO_SECRET_KEY=sb_minio_dev_password
MINIO_BUCKET=second-brain-documents
MINIO_USE_SSL=false

# --- Auth ---
JWT_SECRET=change-me-in-any-real-deployment-this-is-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
