{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/vDevPreview/MicrosoftTeams.schema.json",
  "manifestVersion": "devPreview",
  "version": "0.1.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Second Brain",
    "websiteUrl": "http://localhost:3000",
    "privacyUrl": "http://localhost:3000/privacy",
    "termsOfUseUrl": "http://localhost:3000/terms"
  },
  "name": {
    "short": "Second Brain",
    "full": "Second Brain - Legal Knowledge Archive"
  },
  "description": {
    "short": "Query the firm's matter archive without leaving Outlook or Word.",
    "full": "Second Brain matches a plain-language legal question against the firm's archive of prior matters by legal-issue fingerprint, and surfaces a graded reliability check on relied-upon authorities."
  },
  "icons": {
    "outline": "assets/icon-outline.png",
    "color": "assets/icon-color.png"
  },
  "accentColor": "#1C1A17",
  "_comment_scope": "Scaffold only for this pass (see build plan Section 9 / Phase 5) - a single unified manifest for Microsoft 365, covering both Outlook and Word task panes, per Microsoft's current guidance to avoid the older per-host XML manifest. Not yet sideload-tested against real Outlook/Word clients.",
  "extensions": [
    {
      "requirements": {
        "scopes": ["mail"]
      },
      "runtimes": [
        {
          "requirements": { "capabilities": [{ "name": "Mailbox", "minVersion": "1.1" }] },
          "id": "outlook_taskpane_runtime",
          "type": "general",
          "code": { "page": "http://localhost:3000/addin/outlook" },
          "lifetime": "short",
          "actions": [
            {
              "id": "outlook_taskpane_open",
              "type": "openPage",
              "pinnable": false,
              "view": "outlook_taskpane_view"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["mailRead"],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "secondbrain_outlook_group",
                  "label": "Second Brain",
                  "controls": [
                    {
                      "id": "secondbrain_outlook_button",
                      "type": "button",
                      "label": "Query archive",
                      "icons": [{ "size": 32, "file": "assets/icon-color.png" }],
                      "actionId": "outlook_taskpane_open"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "requirements": {
        "scopes": ["document"]
      },
      "runtimes": [
        {
          "requirements": { "capabilities": [{ "name": "WordApi", "minVersion": "1.3" }] },
          "id": "word_taskpane_runtime",
          "type": "general",
          "code": { "page": "http://localhost:3000/addin/word" },
          "lifetime": "short",
          "actions": [
            {
              "id": "word_taskpane_open",
              "type": "openPage",
              "pinnable": false,
              "view": "word_taskpane_view"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["default"],
          "tabs": [
            {
              "builtInTabId": "TabHome",
              "groups": [
                {
                  "id": "secondbrain_word_group",
                  "label": "Second Brain",
                  "controls": [
                    {
                      "id": "secondbrain_word_button",
                      "type": "button",
                      "label": "Query archive",
                      "icons": [{ "size": 32, "file": "assets/icon-color.png" }],
                      "actionId": "word_taskpane_open"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "authorization": {
    "permissions": {
      "resourceSpecific": []
    }
  }
}
